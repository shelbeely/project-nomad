PORT=8080
HOST=localhost
LOG_LEVEL=info
APP_KEY=some_random_key
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_DATABASE=nomad
DB_PASSWORD=password
DB_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
# Storage path for NOMAD content (ZIM files, maps, etc.)
# On Windows dev, use an absolute path like: C:/nomad-storage
# On Linux production, use: /opt/project-nomad/storage
NOMAD_STORAGE_PATH=/opt/project-nomad/storage

# ---------------------------------------------------------------------------
# AI Provider Configuration
# ---------------------------------------------------------------------------
# Set to 'openrouter' to route all chat inference through OpenRouter instead
# of local Ollama.  Embeddings (RAG) always stay local regardless of this.
# Default: ollama
# AI_PROVIDER=ollama

# Required when AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Model used automatically when messages contain images or video.
# Must be a vision-language model (e.g. openai/gpt-4o, google/gemini-2.0-flash).
# OPENROUTER_VISION_MODEL=openai/gpt-4o

# ---------------------------------------------------------------------------
# Agent / Remote Access Authentication (optional)
# ---------------------------------------------------------------------------
# When set, all /mcp/*, /v1/*, and /api/agent/* routes require either
#   X-NOMAD-Key: <value>  or  Authorization: Bearer <value>
# Leave unset for unauthenticated local-network access (default).
# NOMAD_API_KEY=